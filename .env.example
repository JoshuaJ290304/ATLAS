# PostgreSQL
POSTGRES_DB=atlas_db
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_change_me

# Backend
DATABASE_URL=postgresql+asyncpg://atlas:atlas_change_me@postgres:5432/atlas_db
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Frontend build-time API endpoint
VITE_API_URL=http://localhost:8000/api/v1

# Document processing
UPLOAD_ROOT=storage/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx
