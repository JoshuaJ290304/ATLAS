# Runtime mode: development, test, or production
ENVIRONMENT=development
DEBUG=false
ENABLE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
APP_VERSION=1.0.0-rc.2

# PostgreSQL
POSTGRES_DB=atlas_db
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_change_me
DATABASE_URL=postgresql+asyncpg://atlas:atlas_change_me@postgres:5432/atlas_db

# Authentication and browser access
# Generate a unique secret before sharing or deploying this environment.
JWT_SECRET_KEY=replace_with_a_long_random_secret_of_at_least_48_characters
JWT_ALGORITHM=HS256
JWT_ISSUER=atlas-api
JWT_AUDIENCE=atlas-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_URL=http://localhost:5173
WEB_CONCURRENCY=1

# Persistent authentication rate limits
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_CONFIRM_RATE_LIMIT_ATTEMPTS=10
PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_RETENTION_HOURS=48

# Password recovery and SMTP
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@atlas.local
SMTP_FROM_NAME=ATLAS
SMTP_STARTTLS=false
SMTP_USE_SSL=false

# Frontend build-time endpoints
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAIL_PREVIEW_URL=http://localhost:8025

# Document processing
UPLOAD_ROOT=storage/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx
MAX_DOCX_UNCOMPRESSED_MB=50
MAX_DOCX_COMPRESSION_RATIO=100
MAX_EXTRACTED_TEXT_CHARS=5000000
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=60

# AI project assistant
CHROMA_PERSIST_ROOT=storage/vector
CHROMA_COLLECTION=atlas_project_knowledge
MODEL_CACHE_ROOT=storage/models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=24
ASSISTANT_CHUNK_SIZE=900
ASSISTANT_CHUNK_OVERLAP=120
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=3
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.1
OLLAMA_CONTEXT_WINDOW=8192
ASSISTANT_ALLOW_RETRIEVAL_FALLBACK=true
