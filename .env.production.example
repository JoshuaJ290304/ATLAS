ENVIRONMENT=production
DEBUG=false
ENABLE_API_DOCS=false
SECURITY_HEADERS_ENABLED=true
APP_VERSION=1.0.0-rc.2

POSTGRES_DB=atlas_db
POSTGRES_USER=atlas
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://atlas:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/atlas_db

JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=atlas-api
JWT_AUDIENCE=atlas-frontend
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://atlas.example.com
TRUSTED_HOSTS=atlas.example.com,api.atlas.example.com
FRONTEND_URL=https://atlas.example.com
WEB_CONCURRENCY=1

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_RESET_CONFIRM_RATE_LIMIT_ATTEMPTS=10
PASSWORD_RESET_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_RETENTION_HOURS=48

PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=ATLAS
SMTP_STARTTLS=true
SMTP_USE_SSL=false

VITE_API_URL=https://api.atlas.example.com/api/v1
VITE_MAIL_PREVIEW_URL=

MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.docx
MAX_DOCX_UNCOMPRESSED_MB=50
MAX_DOCX_COMPRESSION_RATIO=100
MAX_EXTRACTED_TEXT_CHARS=5000000
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=60

CHROMA_COLLECTION=atlas_project_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=24
ASSISTANT_CHUNK_SIZE=900
ASSISTANT_CHUNK_OVERLAP=120
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=3
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.1
OLLAMA_CONTEXT_WINDOW=8192
ASSISTANT_ALLOW_RETRIEVAL_FALLBACK=true
